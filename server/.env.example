NODE_ENV=development
PORT=5004
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/insurance_mis_db?retryWrites=true&w=majority
MONGODB_DB_NAME=insurance_mis_db
# Superadmin created on first boot when none exists.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=super123
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
# Optional: overrides the access-token lifetime. Defaults to 5m in dev, 15m in production.
# JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5176
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
# AI policy autofill (reads an uploaded policy PDF). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any OpenRouter model id; ":free" ones may be rate limited.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# AI_TIMEOUT_MS=60000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Insurance MIS <noreply@insurance-mis.local>
