							"mode": "raw",
							"raw": "{\n  \"kind\": \"gi\",\n  \"department\": \"{{departmentId}}\",\n  \"branch\": \"{{branchId}}\",\n  \"location\": \"Jaipur\",\n  \"officeCode\": \"OC-01\",\n  \"policyDate\": \"2026-04-10\",\n  \"entryDate\": \"2026-04-10\",\n  \"policyNo\": \"GI-0001\",\n  \"clientName\": \"Ramesh Kumar\",\n  \"insurer\": \"{{insurerId}}\",\n  \"businessType\": \"{{businessTypeId}}\",\n  \"lob\": \"{{lobId}}\",\n  \"agent\": \"{{agentId}}\",\n  \"source\": \"Direct\",\n  \"reference\": \"REF-1\",\n  \"clientGst\": \"27AAPFU0939F1ZV\",\n  \"vehicleNo\": \"RJ14AB1234\",\n  \"maker\": \"Maruti\",\n  \"model\": \"Swift\",\n  \"mfgDate\": \"2024-01-15\",\n  \"ncb\": 20,\n  \"policyPeriodFrom\": \"2026-04-10\",\n  \"policyPeriodTo\": \"2027-04-09\",\n  \"odPremium\": 1000,\n  \"thirdPartyCover\": 500,\n  \"agentStampDuty\": 1,\n  \"netPremium\": 1501,\n  \"gst\": 270.18,\n  \"premium\": 1771.18,\n  \"commission\": {\n    \"odCommission\": 70,\n    \"tpCommission\": 15,\n    \"totalCommission\": 85,\n    \"odCommissionPercent\": 10,\n    \"tpCommissionPercent\": 7.5,\n    \"totalCommissionPercent\": 9.5,\n    \"status\": \"pending\"\n  }\n}",
