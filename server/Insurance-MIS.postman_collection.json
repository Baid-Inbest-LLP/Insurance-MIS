						"url": {
							"raw": "{{baseUrl}}/transactions/{{transactionId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"transactions",
								"{{transactionId}}"
							]
						},
						"description": "Sends the full set of fields: optional fields left out are cleared. kind and department cannot change. Employees can edit only their own entries; a HOD can edit any entry in their departments; admin and superadmin can edit all. Commission is replaced like the other fields: leave it out to clear it. If the caller cannot manage commission, the stored commission is left untouched. Premium employees never receive commission in responses. commission is optional and everything in it is entered by hand: nothing is calculated. GI: odCommission, tpCommission, totalCommission, odCommissionPercent, tpCommissionPercent, totalCommissionPercent and status; LI: amount, percent and status. Amounts are rupees with at most 2 decimals; percentages are 0 to 100 with at most 2 decimals; status is received or pending. Only superadmin, admin, a HOD (own departments) and a commission employee (own entries) may send it; a premium employee gets 403."
					}
