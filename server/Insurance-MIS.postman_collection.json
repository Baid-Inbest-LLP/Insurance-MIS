						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = pm.response.json();",
									"if (body.success && body.data.length) pm.collectionVariables.set('transactionId', body.data[0]._id);"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/transactions?page=1&limit=20&kind=gi&department={{departmentId}}&from=2026-04-01&to=2026-04-30&search=",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"transactions"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "20"
								},
								{
									"key": "kind",
									"value": "gi",
									"disabled": true
								},
								{
									"key": "department",
									"value": "{{departmentId}}",
									"disabled": true
								},
								{
									"key": "businessType",
									"value": "",
									"description": "business type id",
									"disabled": true
								},
								{
									"key": "productType",
									"value": "",
									"description": "product type id (LI)",
									"disabled": true
								},
								{
									"key": "from",
									"value": "2026-04-01",
									"disabled": true
								},
								{
									"key": "to",
									"value": "2026-04-30",
									"disabled": true
								},
								{
									"key": "search",
									"value": "",
									"disabled": true
								}
							]
						},
						"description": "Filters (all optional): kind, department, branch, insurer, businessType, lob, productType, agent, from, to (policy date range, YYYY-MM-DD), search (policy number or client). Staff roles only see their own departments. Stores the first result as {{transactionId}}."
					}
				},
