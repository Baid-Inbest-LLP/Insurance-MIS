{
	"info": {
		"name": "Insurance MIS API",
		"description": "All Insurance MIS endpoints, grouped by section.\n\n1. Start the server (default http://localhost:5004).\n2. Run Auth > Login as superadmin. It stores accessToken and refreshToken as collection variables.\n3. Every other request inherits Bearer {{accessToken}} from the collection.\n4. List/create requests store ids (companyId, branchId, userId, itemId, cityId) for the requests that follow them.\n\nEdit the variables (baseUrl, department, slug, credentials) on the collection's Variables tab.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5004/api/v1"
		},
		{
			"key": "username",
			"value": "superadmin"
		},
		{
			"key": "password",
			"value": "super123"
		},
		{
			"key": "accessToken",
			"value": ""
		},
		{
			"key": "refreshToken",
			"value": ""
		},
		{
			"key": "slug",
			"value": "insurer",
			"description": "lob | insurer | business-type | product-type"
		},
		{
			"key": "itemId",
			"value": ""
		},
		{
			"key": "companyId",
			"value": ""
		},
		{
			"key": "branchId",
			"value": ""
		},
		{
			"key": "cityId",
			"value": ""
		},
		{
			"key": "userId",
			"value": ""
		},
		{
			"key": "departmentId",
			"value": "",
			"description": "department id; List departments sets it from the first department"
		},
		{
			"key": "transactionId",
			"value": ""
		},
		{
			"key": "insurerId",
			"value": "",
			"description": "item id from Master > Catalog"
		},
		{
			"key": "businessTypeId",
			"value": "",
			"description": "item id from Master > Catalog"
		},
		{
			"key": "lobId",
			"value": "",
			"description": "item id from Master > Catalog"
		},
		{
			"key": "agentId",
			"value": "",
			"description": "item id from Master > Catalog"
		},
		{
			"key": "productTypeId",
			"value": "",
			"description": "item id from Master > Catalog"
		}
	],
	"item": [
		{
			"name": "Health",
			"item": [
				{
					"name": "Health check",
					"request": {
						"method": "GET",
						"header": [],
						"auth": {
							"type": "noauth"
						},
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health"
							]
						}
					}
				}
			]
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = pm.response.json();",
									"if (body.success) {",
									"  pm.collectionVariables.set('accessToken', body.data.accessToken);",
									"  pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"auth": {
							"type": "noauth"
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userName\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					}
				},
				{
					"name": "Refresh token",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = pm.response.json();",
									"if (body.success) pm.collectionVariables.set('accessToken', body.data.accessToken);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"auth": {
							"type": "noauth"
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/refresh",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"refresh"
							]
						}
					}
				},
				{
					"name": "Register user (superadmin)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Test Employee\",\n  \"userName\": \"employee1\",\n  \"password\": \"secret123\",\n  \"role\": \"emp-premium\",\n  \"departments\": [\"{{departmentId}}\"]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"register"
							]
						},
						"description": "role is one of admin, hod, emp-premium, emp-commission. departments (one or more department ids from Master > Departments) is required for hod, emp-premium and emp-commission; leave it out for admin."
					}
				},
				{
					"name": "Get my profile",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/me",
							"host": [
